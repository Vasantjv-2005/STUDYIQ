{
    "compilerOptions": {
        /* Language and environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node"
        ],
        /* Module configuration */
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "verbatimModuleSyntax": true,
        /* Project structure */
        "rootDir": "./src",
        "outDir": "./dist",
        /* Type checking */
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true,
        /* JavaScript compatibility */
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        /* Build configuration */
        "noEmitOnError": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        /* JSON support */
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts"
    ]
}